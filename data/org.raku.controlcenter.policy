<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>raku</vendor>
  <vendor_url>https://github.com/krism-eu/K-ControlC</vendor_url>

  <!-- No auth_admin_keep: every privileged invocation requires a fresh
       authorization decision. argv1 narrows pkexec's path-only matching. -->
  <action id="org.raku.controlcenter.rk.sync">
    <description>Synchronize persistent raku packages</description>
    <message>Authentication is required to synchronize persistent packages</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/rk</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">sync</annotate>
  </action>

  <action id="org.raku.controlcenter.rk.add">
    <description>Add a persistent raku package</description>
    <message>Authentication is required to add a persistent package</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/rk</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">add</annotate>
  </action>

  <action id="org.raku.controlcenter.rk.rm">
    <description>Remove a persistent raku package</description>
    <message>Authentication is required to remove a persistent package</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/rk</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">rm</annotate>
  </action>

  <action id="org.raku.controlcenter.bootc.upgrade">
    <description>Manage bootc upgrades</description>
    <message>Authentication is required to update the operating system</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/bootc</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">upgrade</annotate>
  </action>

  <action id="org.raku.controlcenter.bootc.rollback">
    <description>Manage bootc rollback</description>
    <message>Authentication is required to roll back the operating system</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/bootc</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">rollback</annotate>
  </action>

  <!-- Runtime-only firewalld quick actions. The C++ layer additionally checks
       the complete argument vector; each policy action pins argv1 as well. -->
  <action id="org.raku.controlcenter.firewall.ssh.add">
    <description>Open SSH in the active firewall configuration</description>
    <message>Authentication is required to open SSH</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/firewall-cmd</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--add-service=ssh</annotate>
  </action>
  <action id="org.raku.controlcenter.firewall.ssh.remove">
    <description>Close SSH in the active firewall configuration</description>
    <message>Authentication is required to close SSH</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/firewall-cmd</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--remove-service=ssh</annotate>
  </action>
  <action id="org.raku.controlcenter.firewall.http.add">
    <description>Open HTTP in the active firewall configuration</description>
    <message>Authentication is required to open HTTP</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/firewall-cmd</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--add-service=http</annotate>
  </action>
  <action id="org.raku.controlcenter.firewall.http.remove">
    <description>Close HTTP in the active firewall configuration</description>
    <message>Authentication is required to close HTTP</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/firewall-cmd</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--remove-service=http</annotate>
  </action>
  <action id="org.raku.controlcenter.firewall.https.add">
    <description>Open HTTPS in the active firewall configuration</description>
    <message>Authentication is required to open HTTPS</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/firewall-cmd</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--add-service=https</annotate>
  </action>
  <action id="org.raku.controlcenter.firewall.https.remove">
    <description>Close HTTPS in the active firewall configuration</description>
    <message>Authentication is required to close HTTPS</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/firewall-cmd</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--remove-service=https</annotate>
  </action>
</policyconfig>
